{
  "version": 4,
  "terraform_version": "1.5.0",
  "serial": 2,
  "lineage": "samoyed-grand-tri-cloud-gcp",
  "resources": [
    {
      "mode": "managed",
      "type": "google_compute_network",
      "name": "dmz",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-dmz/global/networks/dmz",
            "name": "dmz",
            "project": "proj-dmz",
            "ipv4_range": "10.0.0.0/16"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network",
      "name": "app",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-app/global/networks/app",
            "name": "app",
            "project": "proj-app",
            "ipv4_range": "10.10.0.0/16"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network",
      "name": "pci",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-pci/global/networks/pci",
            "name": "pci",
            "project": "proj-pci",
            "ipv4_range": "10.20.0.0/16"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network",
      "name": "shared",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-shared/global/networks/shared",
            "name": "shared",
            "project": "proj-shared",
            "ipv4_range": "10.30.0.0/16"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network",
      "name": "staging",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-staging/global/networks/staging",
            "name": "staging",
            "project": "proj-staging",
            "ipv4_range": "10.40.0.0/16"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_subnetwork",
      "name": "dmz_subnet",
      "instances": [
        {
          "attributes": {
            "project": "proj-dmz",
            "network": "projects/proj-dmz/global/networks/dmz",
            "ip_cidr_range": "10.0.1.0/24"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_firewall",
      "name": "bastion_ingress",
      "instances": [
        {
          "attributes": {
            "project": "proj-dmz",
            "name": "bastion-ingress",
            "network": "projects/proj-dmz/global/networks/dmz",
            "source_ranges": [
              "0.0.0.0/0"
            ],
            "allow": [
              {
                "protocol": "tcp",
                "ports": [
                  "22"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network_peering",
      "name": "dmz_app",
      "instances": [
        {
          "attributes": {
            "id": "dmz-app",
            "project": "proj-dmz",
            "network": "projects/proj-dmz/global/networks/dmz",
            "peer_network": "projects/proj-app/global/networks/app",
            "state": "ACTIVE"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network_peering",
      "name": "app_pci",
      "instances": [
        {
          "attributes": {
            "id": "app-pci",
            "project": "proj-app",
            "network": "projects/proj-app/global/networks/app",
            "peer_network": "projects/proj-pci/global/networks/pci",
            "state": "ACTIVE"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "bastion",
      "instances": [
        {
          "attributes": {
            "project": "proj-dmz",
            "email": "bastion@proj-dmz.iam.gserviceaccount.com"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "cloudbuild",
      "instances": [
        {
          "attributes": {
            "project": "proj-shared",
            "email": "cloudbuild@proj-shared.iam.gserviceaccount.com"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "pci_reader",
      "instances": [
        {
          "attributes": {
            "project": "proj-pci",
            "email": "pci-reader@proj-pci.iam.gserviceaccount.com"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_instance",
      "name": "bastion",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-dmz/zones/us-central1-a/instances/bastion-01",
            "name": "bastion-01",
            "project": "proj-dmz",
            "network_interface": [
              {
                "network": "projects/proj-dmz/global/networks/dmz",
                "subnetwork": "projects/proj-dmz/regions/us-central1/subnetworks/dmz",
                "network_ip": "10.0.1.10",
                "access_config": [
                  {
                    "nat_ip": "203.0.113.10"
                  }
                ]
              }
            ],
            "service_account": [
              {
                "email": "bastion@proj-dmz.iam.gserviceaccount.com"
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_cloud_run_v2_service",
      "name": "api",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-app/locations/us-central1/services/app-api",
            "name": "app-api",
            "project": "proj-app",
            "template": [
              {
                "service_account": "app-deploy@proj-app.iam.gserviceaccount.com"
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_storage_bucket",
      "name": "pci_exports",
      "instances": [
        {
          "attributes": {
            "name": "corp-pci-crown-jewel",
            "project": "proj-pci"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_secret_manager_secret",
      "name": "prod_db",
      "instances": [
        {
          "attributes": {
            "project": "proj-pci",
            "secret_id": "prod-db-password"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account_iam_member",
      "name": "build_impersonates_pci",
      "instances": [
        {
          "attributes": {
            "project": "proj-pci",
            "service_account_id": "pci-reader@proj-pci.iam.gserviceaccount.com",
            "member": "serviceAccount:cloudbuild@proj-shared.iam.gserviceaccount.com",
            "role": "roles/iam.serviceAccountTokenCreator"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_iam_workload_identity_pool",
      "name": "github",
      "instances": [
        {
          "attributes": {
            "project": "proj-shared",
            "id": "projects/proj-shared/locations/global/workloadIdentityPools/github",
            "workload_identity_pool_id": "github"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_iam_workload_identity_pool_provider",
      "name": "github_oidc",
      "instances": [
        {
          "attributes": {
            "project": "proj-shared",
            "id": "projects/proj-shared/locations/global/workloadIdentityPools/github/providers/github-oidc"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "app_deploy",
      "instances": [
        {
          "attributes": {
            "project": "proj-app",
            "email": "app-deploy@proj-app.iam.gserviceaccount.com",
            "account_id": "app-deploy",
            "display_name": "app-deploy"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "decoy_metrics",
      "instances": [
        {
          "attributes": {
            "project": "proj-staging",
            "email": "decoy-metrics@proj-staging.iam.gserviceaccount.com",
            "account_id": "decoy-metrics"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_instance",
      "name": "app_worker",
      "instances": [
        {
          "attributes": {
            "id": "projects/proj-app/zones/us-central1-a/instances/app-worker-1",
            "name": "app-worker-1",
            "project": "proj-app",
            "network_interface": [
              {
                "network": "projects/proj-app/global/networks/app",
                "subnetwork": "projects/proj-app/regions/us-central1/subnetworks/app",
                "network_ip": "10.10.1.40"
              }
            ],
            "service_account": [
              {
                "email": "app-deploy@proj-app.iam.gserviceaccount.com"
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_subnetwork",
      "name": "app_subnet",
      "instances": [
        {
          "attributes": {
            "project": "proj-app",
            "name": "app",
            "network": "projects/proj-app/global/networks/app",
            "ip_cidr_range": "10.10.1.0/24",
            "id": "projects/proj-app/regions/us-central1/subnetworks/app"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account_iam_member",
      "name": "app_deploy_impersonates_build",
      "instances": [
        {
          "attributes": {
            "project": "proj-shared",
            "service_account_id": "cloudbuild@proj-shared.iam.gserviceaccount.com",
            "member": "serviceAccount:app-deploy@proj-app.iam.gserviceaccount.com",
            "role": "roles/iam.serviceAccountTokenCreator"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_storage_bucket",
      "name": "staging_scratch",
      "instances": [
        {
          "attributes": {
            "name": "corp-staging-scratch-deadend",
            "project": "proj-staging"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_storage_bucket_iam_member",
      "name": "pci_reader_crown",
      "instances": [
        {
          "attributes": {
            "bucket": "corp-pci-crown-jewel",
            "role": "roles/storage.objectViewer",
            "member": "serviceAccount:pci-reader@proj-pci.iam.gserviceaccount.com",
            "project": "proj-pci"
          }
        }
      ]
    }
  ]
}
